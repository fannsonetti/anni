{
  "manifest_version": 3,
  "name": "Anni Connect",
  "version": "0.1.0",
  "description": "Connect your INNA login to Anni on this computer when you choose Connect.",
  "minimum_chrome_version": "102",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://nam.inna.is/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Anni Connect", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_idle"}]
}
